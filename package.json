{
  "name": "payroute",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm -r run lint",
    "dev:engine": "pnpm --filter @payroute/engine dev",
    "dev:provider-lab": "pnpm --filter @payroute/provider-lab dev",
    "dev:lab-ui": "pnpm --filter @payroute/lab-ui dev",
    "dev:ui": "pnpm --filter @payroute/lab-ui dev",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f",
    "benchmark": "tsx benchmarks/runner.ts",
    "benchmark:payments": "tsx benchmarks/scenarios/payments-throughput.ts",
    "benchmark:idempotency": "tsx benchmarks/scenarios/idempotency-race.ts",
    "benchmark:breaker": "tsx benchmarks/scenarios/breaker-storm.ts",
    "benchmark:telemetry": "tsx benchmarks/scenarios/telemetry-read.ts"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/node": "^22.13.4",
    "autocannon": "^8.0.0",
    "dotenv": "^18.0.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
