{
  "name": "payroute",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm -r run lint",
    "dev:engine": "pnpm --filter @payroute/engine dev",
    "dev:provider-lab": "pnpm --filter @payroute/provider-lab dev",
    "dev:lab-ui": "pnpm --filter @payroute/lab-ui dev",
    "dev:ui": "pnpm --filter @payroute/lab-ui dev",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
