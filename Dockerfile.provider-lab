FROM node:22-alpine AS builder

WORKDIR /app

# Enable pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy workspace configurations
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY apps/provider-lab/package.json ./apps/provider-lab/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code
COPY apps/provider-lab ./apps/provider-lab

# Build provider-lab
RUN pnpm --filter @payroute/provider-lab run build

# Production runtime stage
FROM node:22-alpine AS runner

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/provider-lab/package.json ./apps/provider-lab/

RUN pnpm install --prod --frozen-lockfile

COPY --from=builder /app/apps/provider-lab/dist ./apps/provider-lab/dist

ENV NODE_ENV=production
ENV PROVIDER_LAB_PORT=4000
ENV HOST=0.0.0.0

EXPOSE 4000

CMD ["node", "apps/provider-lab/dist/index.js"]
